---
import type { Berita } from '../../components/berita';
import { formatBeritaDate, getOtherBerita, BERITA } from '../../components/berita';
import Layout from '../../layouts/Layout.astro';

interface Props {
	article: Berita;
}

export function getStaticPaths() {
	return BERITA.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}));
}

const { article } = Astro.props;

const site = Astro.site ?? new URL('https://imajinari.id');
const canonical = new URL(`/berita/${article.slug}`, site);
const related = getOtherBerita(article.slug, 2);

const pageDescription =
	article.intro.length <= 155
		? article.intro
		: `${article.intro.slice(0, 152).trimEnd()}…`;

const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: article.title,
	url: canonical.href,
	image: new URL(article.image, site).href,
	datePublished: article.date,
	inLanguage: 'id',
	description: article.intro,
	publisher: { '@type': 'Organization', name: 'Imajinari' },
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Beranda', item: site.href },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Berita',
			item: new URL('/berita', site).href,
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: article.title,
			item: canonical.href,
		},
	],
};
---

<Layout
	title={`${article.title} — Berita Imajinari`}
	description={pageDescription}
	image={article.image}
	type="article"
>
	{/* Kolom baca sempit (760px) mengikuti halaman detail Agentframe: bar
	    navigasi lokal → header artikel → gambar → isi → kaki artikel. */}
	<main class="mx-auto w-full max-w-[760px] px-4 pt-28 pb-16 sm:px-6 sm:pt-32 sm:pb-20 lg:pb-24">
		<header class="pb-8 sm:pb-10">
			<div class="flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-[0.08em] text-neutral-500 uppercase">
				<span class="text-(--color-accent)">{article.category}</span>
				<span aria-hidden="true">/</span>
				<time datetime={article.date}>
					{formatBeritaDate(article.date)}
				</time>
			</div>

			<h1 class="mt-6 text-[38px] leading-[1.12] font-medium tracking-tight text-balance text-neutral-100 sm:text-5xl sm:leading-[1.1] lg:text-[56px] lg:leading-[1.08]">
				{article.title}
			</h1>

			<p class="mt-6 text-[17px] leading-[1.65] text-pretty text-neutral-400 sm:text-[19px]">
				{article.intro}
			</p>
		</header>

		<figure>
			<div class="relative aspect-[16/9] overflow-hidden border border-white/10 bg-neutral-900 max-sm:aspect-[4/3]">
				<img
					src={article.image}
					alt={article.alt}
					loading="eager"
					fetchpriority="high"
					draggable="false"
					class="absolute inset-0 h-full w-full object-cover"
				/>
			</div>
		</figure>

		<article class="mt-12 flex flex-col gap-10 max-sm:mt-9 max-sm:gap-8">
			{article.sections.map((section) => (
				<section>
					<h2 class="text-[26px] leading-[1.3] font-medium tracking-tight text-balance text-neutral-100 sm:text-[30px]">
						{section.heading}
					</h2>
					<p class="mt-4 text-[16px] leading-[1.8] text-pretty text-neutral-400 sm:text-[17px]">
						{section.text}
					</p>
				</section>
			))}
		</article>

		{/* Baca juga: dua artikel lain, kartu ringkas tanpa metadata tambahan. */}
		{related.length > 0 && (
			<nav
				aria-label="Baca juga"
				class="mt-12 border-t border-white/10 pt-7"
			>
				<div class="flex flex-wrap items-center justify-between gap-4">
					<h2 class="font-mono text-[10px] tracking-[0.08em] text-neutral-500 uppercase">
						Baca juga
					</h2>
					<a
						href="/berita"
						class="group inline-flex items-center gap-2 font-mono text-[10px] tracking-[0.08em] text-neutral-500 uppercase transition-colors hover:text-neutral-100"
					>
						Lihat semua berita
						<span
							aria-hidden="true"
							class="transition-transform duration-200 group-hover:translate-x-0.5"
						>
							→
						</span>
					</a>
				</div>
				<div class="mt-5 grid gap-8 sm:grid-cols-2">
					{related.map((item) => (
						<a
							href={`/berita/${item.slug}`}
							class="group cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-100"
						>
							<div class="relative aspect-[16/9] overflow-hidden border border-white/10 bg-neutral-900">
								<img
									src={item.image}
									alt={item.alt}
									loading="lazy"
									draggable={false}
									class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
								/>
							</div>
							<time
								datetime={item.date}
								class="mt-4 block font-mono text-[10px] tracking-[0.08em] text-neutral-500 uppercase"
							>
								{formatBeritaDate(item.date)}
							</time>
							<h3 class="mt-2 text-lg leading-snug font-medium tracking-tight text-balance text-neutral-100 group-hover:underline group-hover:underline-offset-4 sm:text-xl">
								{item.title}
							</h3>
						</a>
					))}
				</div>
			</nav>
		)}
	</main>

	<script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>
