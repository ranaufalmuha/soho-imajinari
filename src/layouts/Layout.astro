---
import '../styles/global.css';
import Navigation9 from '../components/blocks/navigation-9.tsx';
import Footer from '../components/Footer.tsx';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>imajinari — Imajinasi dalam Gerak</title>
		<meta name="description" content="Galeri interaktif imajinari: seret, putar, dan jelajahi delapan karya abstrak dalam cincin 3D yang hidup." />
	</head>
	<body class="bg-[#0b0b12] text-neutral-100 antialiased">
		<Navigation9 client:load />
		<slot />
		<Footer client:visible />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
